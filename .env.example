# Server Configuration
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crawler_db

# Cache & Queue Configuration (Redis)
REDIS_HOST=cache
REDIS_PORT=6379
